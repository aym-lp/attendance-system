# Supabase (optional - for database integration)
# NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Apps Script Web App (給与明細連携用)
# デプロイしたWeb AppのURL（https://script.google.com/...）
GOOGLE_APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/your-web-app-id/exec

# Web Appで検証用のAPIキーを設定した場合のみ（任意）
GOOGLE_APPS_SCRIPT_WEB_APP_TOKEN=your-optional-secret-token
