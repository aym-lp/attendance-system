# Supabase (optional - for database integration)
# NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Sheets API (給与明細連携用)
# サービスアカウントのクライアントメール
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# サービスアカウントの秘密鍵（-----BEGIN PRIVATE KEY----- で始まるもの）
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 給与明細スプレッドシートID（URLの /d/ と /edit の間の文字列）
GOOGLE_SHEETS_SPREADSHEET_ID=1DeQdS71jVkWd69u1Yb2xDzxZRgQ02klkIgkLEdZ0JtM

# シート名（デフォルト: "Sheet1"）
GOOGLE_SHEETS_SHEET_NAME=Sheet1
